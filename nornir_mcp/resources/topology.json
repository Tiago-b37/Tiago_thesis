        "layer": "underlay",
        "subnet": "10.0.12.0/31",
        "description": "Spine1 to Leaf2 underlay link"
      },
      {
        "source": "spine2-dc2",
        "source_interface": "eth1",
        "target": "leaf1-dc2",
        "target_interface": "eth2",
        "layer": "underlay",
        "subnet": "10.0.21.0/31",
        "description": "Spine2 to Leaf1 underlay link"
      },
      {
        "source": "spine2-dc2",
        "source_interface": "eth2",
