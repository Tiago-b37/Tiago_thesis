        "layer": "access",
        "description": "RED tenant access port on leaf1"
      },
      {
        "source": "leaf2-dc2",
        "source_interface": "eth4",
        "target": "client11-dc2",
        "target_interface": "eth1",
        "layer": "access",
        "description": "RED tenant access port on leaf2"
      }
