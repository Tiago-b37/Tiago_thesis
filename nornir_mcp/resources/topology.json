        "layer": "underlay",
        "subnet": "10.0.22.0/31",
        "description": "Spine2 to Leaf2 underlay link"
      },
      {
        "source": "leaf1-dc2",
        "source_interface": "eth3",
        "target": "client8-dc2",
        "target_interface": "eth1",
