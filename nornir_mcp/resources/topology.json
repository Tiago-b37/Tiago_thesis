    "summary": {
      "arista_nodes": [
        "spine1-dc2",
        "spine2-dc2",
        "leaf1-dc2",
        "leaf2-dc2"
      ],
      "linux_clients": [
        "client8-dc2",
        "client9-dc2",
        "client10-dc2",
        "client11-dc2"
