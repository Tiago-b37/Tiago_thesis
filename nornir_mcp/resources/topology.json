        "leaf2-dc2"
      ],
      "evpn_overlay_nodes": [
        "leaf1-dc2",
        "leaf2-dc2"
      ],
      "underlay_transit_nodes": [
        "spine1-dc2",
        "spine2-dc2"
      ],
      "route_reflectors": []
    }
  }
}
