        "description": "BLUE tenant access port on leaf1"
      },
      {
        "source": "leaf2-dc2",
        "source_interface": "eth3",
        "target": "client9-dc2",
        "target_interface": "eth1",
        "layer": "access",
        "description": "BLUE tenant access port on leaf2"
      },
      {
        "source": "leaf1-dc2",
        "source_interface": "eth4",
        "target": "client10-dc2",
