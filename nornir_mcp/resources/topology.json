{
  "topology": {
    "lab_name": "dc2-topology",
    "platform": "containerlab",
    "image": "ceos:4.34.3.1M",
    "mgmt_subnet": "172.20.0.0/24",
    "nodes": [
      {
        "id": "spine1-dc2",
        "type": "spine",
        "platform": "arista_ceos",
        "group": "spine",
        "mgmt_ip": "172.20.0.2",
        "role": "Spine switch; eBGP underlay transit node for leaf reachability"
      },
      {
        "id": "spine2-dc2",
        "type": "spine",
        "platform": "arista_ceos",
        "group": "spine",
        "mgmt_ip": "172.20.0.3",
        "role": "Spine switch; eBGP underlay transit node for leaf reachability"
      },
      {
        "id": "leaf1-dc2",
        "type": "leaf",
        "platform": "arista_ceos",
        "group": "leaf",
        "mgmt_ip": "172.20.0.11",
        "role": "Leaf switch and VTEP serving client8-dc2 and client10-dc2"
      },
      {
        "id": "leaf2-dc2",
        "type": "leaf",
        "platform": "arista_ceos",
        "group": "leaf",
        "mgmt_ip": "172.20.0.12",
        "role": "Leaf switch and VTEP serving client9-dc2 and client11-dc2"
      },
      {
        "id": "client8-dc2",
        "type": "client",
        "platform": "linux",
        "group": "client",
        "mgmt_ip": "172.20.0.101",
        "role": "Linux client connected to leaf1-dc2 Ethernet3"
      },
      {
        "id": "client9-dc2",
        "type": "client",
        "platform": "linux",
        "group": "client",
        "mgmt_ip": "172.20.0.102",
        "role": "Linux client connected to leaf2-dc2 Ethernet3"
      },
      {
        "id": "client10-dc2",
        "type": "client",
        "platform": "linux",
        "group": "client",
        "mgmt_ip": "172.20.0.103",
        "role": "Linux client connected to leaf1-dc2 Ethernet4"
      },
      {
        "id": "client11-dc2",
        "type": "client",
        "platform": "linux",
        "group": "client",
        "mgmt_ip": "172.20.0.104",
        "role": "Linux client connected to leaf2-dc2 Ethernet4"
      }
    ],
    "links": [
